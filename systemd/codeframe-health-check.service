# Template. `scripts/install-health-check.sh` substitutes __CF_USER__ and
# __CF_ROOT__ at install time; systemd never sees the placeholders.
[Unit]
Description=CodeFRAME Staging Server Health Check
Documentation=https://github.com/frankbria/codeframe

[Service]
Type=oneshot
User=__CF_USER__
WorkingDirectory=__CF_ROOT__
ExecStart=__CF_ROOT__/scripts/health-check.sh
StandardOutput=append:__CF_ROOT__/logs/health-check.log
StandardError=append:__CF_ROOT__/logs/health-check.log

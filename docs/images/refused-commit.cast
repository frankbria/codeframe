[38.742018, "o", "\u001b[?1h\u001b=\r\u001b[1mdiff --git a/src/shop/shipping.py b/src/shop/shipping.py\u001b[m\u001b[m\r\n\u001b[1mindex 458ba0a..b9d8953 100644\u001b[m\u001b[m\r\n\u001b[1m--- a/src/shop/shipping.py\u001b[m\u001b[m\r\n\u001b[1m+++ b/src/shop/shipping.py\u001b[m\u001b[m\r\n\u001b[36m@@ -2,14 +2,12 @@\u001b[m \u001b[mfrom decimal import Decimal\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n from shop.cart import Cart\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n\u001b[31m-PER_ITEM = Decimal(\"5.00\")\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mFLAT_RATE = Decimal(\"5.00\")\u001b[m\u001b[m\r\n FREE_SHIPPING_OVER = Decimal(\"50.00\")\u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n \u001b[m\u001b[m\r\n def shipping_cost(cart: Cart) -> Decimal:\u001b[m\u001b[m\r\n\u001b[31m-    \"\"\"$5 per item; free when the subtotal is over $50.\"\"\"\u001b[m\u001b[m\r\n\u001b[31m-    cost = Decimal(\"0.00\")\u001b[m\u001b[m\r\n\u001b[31m-    for item in cart.items:\u001b[m\u001b[m\r\n\u001b[31m-        if cart.subtotal <= FREE_SHIPPING_OVER:\u001b[m\u001b[m\r\n\u001b[31m-            cost += PER_ITEM * item.qty\u001b[m\u001b[m\r\n\u001b[31m-    return cost\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"A flat $5 per order; free when the subtotal is over $50.\"\"\"\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if not cart.items or cart.subtotal > FREE_SHIPPING_OVER:\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return Decimal(\"0.00\")\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return FLAT_RATE\u001b[m\u001b[m\r\n\r\u001b[K\u001b[?1l\u001b>"]

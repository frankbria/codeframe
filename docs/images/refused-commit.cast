[7.634112, "o", "\u001b[3m                                   Proof Requirements (4)                                   \u001b[0m\r\n┏━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mID      \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mTitle                                \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mSeverity\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mStatus   \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mGates         \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━━━┩\r\n│\u001b[36m \u001b[0m\u001b[36mREQ-0004\u001b[0m\u001b[36m \u001b[0m│ Gift cards must not be taxed          │ \u001b[34mmedium\u001b[0m   │ \u001b[2mwaived\u001b[0m    │ unit, contract │\r\n│\u001b[36m \u001b[0m\u001b[36mREQ-0003\u001b[0m\u001b[36m \u001b[0m│ test_tax_rounding keeps passing       │ \u001b[34mmedium\u001b[0m   │ \u001b[32msatisfied\u001b[0m │ unit           │\r\n│\u001b[36m \u001b[0m\u001b[36mREQ-0002\u001b[0m\u001b[36m \u001b[0m│ test_cart_subtotal keeps passing      │ \u001b[34mmedium\u001b[0m   │ \u001b[32msatisfied\u001b[0m │ unit           │\r\n│\u001b[36m \u001b[0m\u001b[36mREQ-0001\u001b[0m\u001b[36m \u001b[0m│ Orders over $50 were charged shipping │ \u001b[33mhigh\u001b[0m     │ \u001b[32msatisfied\u001b[0m │ unit, contract │\r\n└──────────┴───────────────────────────────────────┴──────────┴───────────┴────────────────┘\r\n"]

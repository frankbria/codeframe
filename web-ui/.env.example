# Copy to .env.local for `npm run dev`. With nothing set, the web UI talks to
# `codeframe serve` on its default, http://localhost:8080 (#1296).

# Where the Next.js dev server proxies /api and /auth (build-time).
# BACKEND_ORIGIN=http://localhost:8080

# The backend origin the browser dials directly for streams and sockets: SSE
# and WebSockets cannot go through the Next.js proxy, which buffers chunked
# responses. Set it when the backend is not on localhost:8080.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Only if streams or sockets live on a different origin than the API. Leave
# them unset otherwise: an explicit value wins over the one derived from
# NEXT_PUBLIC_API_URL, so a stale one here silently breaks every stream.
# Origins only; the app appends /api/... and /ws/... itself.
# NEXT_PUBLIC_SSE_URL=http://localhost:8080
# NEXT_PUBLIC_WS_URL=ws://localhost:8080
